{
	"name": "era",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun --bun vite dev --host 127.0.0.1",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host 127.0.0.1",
		"start": "bun build/index.js",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test tests/*.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:browser": "bun run build && playwright test",
		"import": "bun scripts/import.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^22.20.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/common": "^1.5.5",
		"@lezer/highlight": "^1.2.5",
		"@lezer/markdown": "^1.8.1",
		"@silkdown/core": "file:vendor/silkdown",
		"emoji-picker-element": "^1.29.1",
		"emoji-picker-element-data": "^1.8.0"
	},
	"packageManager": "bun@1.4.4"
}
